{
  "server": {
    "url": "https://monitor.example.com:30443/arcgis",
    "_url_comment": "For installations WITH PORT (direct): https://server:30443/arcgis | For installations WITH WEB ADAPTOR: https://server/monitor",
    "username": "admin",
    "password": "Base64EncodedPassword==",
    "password_encoding": true,
    "ignore_ssl_errors": true,
    "timeout_seconds": 600
  },
  "report": {
    "collection": "*",
    "timezone": "America/Bogota",
    "end_time": {
      "now": true,
      "year": 2025,
      "month": 1,
      "day": 27,
      "hour": 23,
      "minute": 59,
      "second": 59
    },
    "past_days": 7,
    "past_hours": 0,
    "types": [
      "host",
      "service",
      "database"
    ],
    "metrics": {
      "alerting_on_only": false,
      "include_only": [
        "CPU",
        "Memory",
        "Disk"
      ],
      "exclude_metrics": [
        "Test",
        "Debug"
      ]
    },
    "page_size": 500,
    "metric_bucket": "observed_at:1h",
    "include_metric_time_series": true,
    "max_metric_ids_for_time_series": 500
  }
}
